# ------------------------------------------------------------------ majra .env
# Copy to `.env` and fill in. Never commit the real .env (it holds secrets).
# All variables are prefixed MAJRA_.

# --- runtime ---
MAJRA_ENVIRONMENT=dev                     # dev | test | production

# --- database / broker (compose sets these itself; only override if needed) ---
# MAJRA_DATABASE_URL=postgresql+psycopg://majra:majra@localhost:5432/majra
# MAJRA_REDIS_URL=redis://localhost:6379/0

# Compose-only convenience (used by infra/docker-compose.yml):
MAJRA_PG_USER=majra
MAJRA_PG_PASSWORD=majra
MAJRA_PG_DB=majra

# --- auth ---
# Long random string. Generate: openssl rand -hex 32
MAJRA_SECRET_KEY=change-me-openssl-rand-hex-32
MAJRA_ACCESS_TOKEN_MINUTES=15
MAJRA_REFRESH_TOKEN_DAYS=30
# Public sign-up. Off by default: only the first account on an empty database
# can register (and becomes the owner, the only one allowed to change FX rates).
MAJRA_ALLOW_REGISTRATION=false

# --- token encryption at rest (REQUIRED) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAJRA_ENCRYPTION_KEY=

# --- public base URL (must be reachable by the browser for OAuth callbacks) ---
# Local dev with a tunnel, e.g. https://your-subdomain.trycloudflare.com
MAJRA_PUBLIC_BASE_URL=http://localhost:8000

# --- Meta (Phase 0 output) ---
MAJRA_META_APP_ID=
MAJRA_META_APP_SECRET=

# --- Google Ads (Phase 0 output) ---
# OAuth client (type: Web) from Google Cloud Console + a developer token from an
# MCC. GA4/GTM/Sheets will later use a service account instead of OAuth.
MAJRA_GOOGLE_CLIENT_ID=
MAJRA_GOOGLE_CLIENT_SECRET=
MAJRA_GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: manager (MCC) account id, digits only, no dashes.
MAJRA_GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- TikTok Ads (Phase 0 output) ---
MAJRA_TIKTOK_APP_ID=
MAJRA_TIKTOK_APP_SECRET=

# --- Snapchat Ads (Phase 0 output) ---
MAJRA_SNAP_CLIENT_ID=
MAJRA_SNAP_CLIENT_SECRET=

# --- GA4 and GTM ---
# Neither needs env vars: each connection stores its own service-account JSON
# (posted to /connections/service-account). Grant that service account Viewer on
# the GA4 property, and read access on the GTM account/container.

# --- alerts (see backend/app/services/alerts.py) ---
# Raised on: final sync failure, skipped ad accounts, a token expiring within
# 14 days, Meta API version warnings, stale data, budget overspend, spend
# anomalies — plus a daily digest. GET /health shows `alerts_configured`.
#
# WhatsApp (Meta WhatsApp Cloud API). Set these ONLY as Railway variables on the
# backend + worker + beat services — never commit them.
MAJRA_ALERT_WHATSAPP_TOKEN=
MAJRA_ALERT_WHATSAPP_PHONE_NUMBER_ID=
# Recipients, comma-separated, international format (e.g. 9665XXXXXXXX).
MAJRA_ALERT_WHATSAPP_TO=
# WhatsApp only delivers free-form business messages within 24h of the
# recipient last messaging the business number. For reliable alerts, approve a
# Utility template with ONE body variable {{1}} and name it here.
MAJRA_ALERT_WHATSAPP_TEMPLATE=
MAJRA_ALERT_WHATSAPP_TEMPLATE_LANG=en
# Hour (UTC) for the token check and the daily digest. 5 = 08:00 Riyadh.
MAJRA_ALERT_DIGEST_HOUR_UTC=5
# Optional: also POST each alert as JSON {"event": <kind>, ...} here.
MAJRA_ALERT_WEBHOOK_URL=

# --- exports ---
# Hard cap so one careless query can't exhaust memory.
MAJRA_EXPORT_MAX_ROWS=200000

# --- production: TLS + domain (used by infra/production/compose.prod.yml) ---
MAJRA_DOMAIN=majra.example.com
MAJRA_ACME_EMAIL=you@example.com
MAJRA_BACKUP_DIR=./backups
MAJRA_GRAFANA_PASSWORD=change-me

# --- hardening ---
# Browser origins allowed to call the API directly. EMPTY = locked down, which is
# right: the dashboard proxies server-side and needs no CORS. Only add an origin
# if you're building a separate browser app against an API key.
# MAJRA_CORS_ORIGINS=["https://app.example.com"]
MAJRA_RATE_LIMIT_AUTH=10/minute
MAJRA_RATE_LIMIT_READ=120/minute
# With more than one API worker, an in-process limit lets N x the traffic through.
# The production compose points this at redis for you.
MAJRA_RATE_LIMIT_STORAGE=memory://
MAJRA_RATE_LIMIT_ENABLED=true
# Send HSTS. Only when you're actually behind TLS.
MAJRA_HSTS_ENABLED=false
# Prometheus scrapes /_metrics (NOT /metrics — that's the query API).
MAJRA_METRICS_ENABLED=true
# In production /_metrics (and /docs, /redoc, /openapi.json) return 404. Set this
# only where the API isn't internet-reachable and Prometheus scrapes internally.
MAJRA_METRICS_IN_PRODUCTION=false

# --- SMTP (only needed for emailed saved reports) ---
MAJRA_SMTP_HOST=
MAJRA_SMTP_PORT=587
MAJRA_SMTP_USER=
MAJRA_SMTP_PASSWORD=
MAJRA_SMTP_FROM=majra@localhost
MAJRA_SMTP_STARTTLS=true
